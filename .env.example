# Copy to .env for MOUNT_PATH (read when Astro starts) and to .dev.vars for the runtime keys below (what the
# Worker sees in `astro dev`). With no Supabase keys, `astro dev` keeps turns and wins in memory so the whole flow
# can be clicked through locally; a production build never does.
# In production every runtime value is set in the Webflow Cloud app's environment variables, except MOUNT_PATH,
# which Webflow Cloud injects from the mount path and must NOT be set there.

# Reproduces the production mount locally so URLs match: http://localhost:4321/dial/
MOUNT_PATH=/dial

# Supabase (same project as Instant Pricing). Use the server-only secret key, never the anon/publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Monday leads board (same board and token as Instant Pricing).
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# Id of the "Code status" status column (labels: Issued, Redeemed, Expired). Optional until the column exists.
MONDAY_CODE_STATUS_COLUMN=
# Shared secret in the Monday webhook URL: /dial/api/redeemed?key=<this>
MONDAY_WEBHOOK_SECRET=

# Podium: texts each winner their code.
PODIUM_API_TOKEN=
PODIUM_LOCATION_UID=

# Klaviyo: each win becomes a "Comfort Dial Won" event for the reminder flow. Private key with write access to
# profiles, events and subscriptions. KLAVIYO_SMS_LIST_ID is optional: the list reminder opt-ins are subscribed to.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_SMS_LIST_ID=

# Cloudflare Turnstile (invisible bot check on each turn). Both empty = check skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to "off" only if /api/health?deep=1 shows the same IP for everyone (a proxy), which would make the per-IP
# limits block real visitors.
DIAL_IP_LIMITS=on
