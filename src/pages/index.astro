---
/* /dial/ — a plain page that opens the dial right away. It is the QA page (`astro dev`, the Webflow Cloud staging URL)
 * and doubles as a direct link. On the real site the dial runs from the dial.js embed, not from here. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Comfort Dial | Always Ready Repair</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,700..900&family=Oswald:wght@500;600&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      :root { --blue:#084e91; --red:#ee292f; --white:#f9f7f8; --black:#221f20; --navy:#14284e; --gray:#dee5ee; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--white); color: var(--black); font: 16px/1.6 Inter, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
      .bar { background: var(--blue); color: var(--white); padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .bar img { height: 36px; }
      .bar a { color: var(--white); font: 600 14px/1 Oswald, sans-serif; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; }
      main { max-width: 760px; margin: 0 auto; padding: 40px 16px 80px; }
      h1 { font: 900 clamp(30px, 6vw, 48px)/1.02 Archivo, Arial Black, sans-serif; font-stretch: 125%; text-transform: uppercase; letter-spacing: -.02em; color: var(--blue); margin: 0 0 12px; }
      .stripe { height: 7px; border-radius: 99px; background: linear-gradient(90deg, var(--red) 0 50%, var(--blue) 50% 100%); margin: 0 0 24px; }
      p { max-width: 62ch; }
      button { font: 600 15px/1 Oswald, sans-serif; letter-spacing: .08em; text-transform: uppercase; background: var(--red); color: #fff; border: 0; border-radius: 8px; padding: 15px 22px; cursor: pointer; }
      .foot { margin-top: 48px; padding-top: 14px; border-top: 2px solid #c9d4e2; font-size: 13px; color: #5c6672; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    </style>
  </head>
  <body>
    <div class="bar">
      <img src="https://cdn.prod.website-files.com/67706112234589f93fe7a263/6770706cd327b7c71e895d05_Main%20Logo.svg" alt="Always Ready Repair" />
      <a href="tel:7086710813">(708) 671-0813</a>
    </div>
    <main>
      <h1>The Comfort Dial</h1>
      <div class="stripe"></div>
      <p>Turn the dial and win a real gift from Always Ready Repair: money off a repair, duct cleaning or a new water heater, a free service call, or a free year of membership. Every turn wins. The odds are posted on the dial.</p>
      <button type="button" data-arr-dial="open">Turn the dial</button>
      <div class="foot">
        <div>Always Ready Repair · (708) 671-0813 · alwaysreadyrepair.com</div>
        <div>Always Ready, Always Reliable.</div>
      </div>
    </main>
    <script is:inline define:vars={{ apiBase: `${base}api/` }}>
      // QA overrides: ?split=0 shows what the control half sees; ?snooze=7 keeps it closed after the first view.
      const q = new URLSearchParams(location.search);
      window.__ARR_DIAL__ = Object.assign({
        apiBase, split: q.has('split') ? Number(q.get('split')) : 1, delayMs: 600,
        snoozeDays: q.has('snooze') ? Number(q.get('snooze')) : 0, excludePaths: []
      }, window.__ARR_DIAL__ || {});
    </script>
    <script>
      import '../widget/index.js';
    </script>
  </body>
</html>
